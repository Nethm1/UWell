# For a physical device, replace this IP address with your development machine's LAN IP.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.25:8082/api
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:8082/api

# Optional override for Socket.IO. Defaults to the API host without /api.
EXPO_PUBLIC_SOCKET_URL=

# Public Jitsi works without an API key. Use your own HTTPS Jitsi domain for production.
EXPO_PUBLIC_JITSI_DOMAIN=meet.jit.si
