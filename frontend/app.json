{
  "expo": {
    "name": "UWell",
    "slug": "uwell",
    "version": "1.0.0",
    "main": "App.jsx",
    "orientation": "portrait",
    "icon": "./src/assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uwell.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uwell.app"
    },
    "web": {
      "favicon": "./src/assets/icons/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "UWell needs access to your photos so you can share images in private chats.",
          "cameraPermission": "UWell uses your camera so you can capture and share images in private chats.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
